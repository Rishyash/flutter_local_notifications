<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.dexterous.flutterlocalnotifications">
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application>
        <!--
          Dedicated activity used as the target for fullScreenIntent notifications.
          It shows over the lock screen and wakes the display without touching the
          host app's main activity.  Consumers do not need to add anything to their
          own AndroidManifest.xml for this to work.
        -->
        <activity
            android:name=".FullScreenNotificationActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/FullScreenNotificationTheme"
            android:hardwareAccelerated="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
    </application>
</manifest>
